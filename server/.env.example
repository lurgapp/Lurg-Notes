# Copy to .env and generate JWT_SECRET with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
DATABASE_URL=postgresql+asyncpg://notes:replace-with-local-db-password@localhost:5432/lurg_notes
JWT_SECRET=replace-with-your-generated-random-secret
COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
AUTH_ALLOWED_APPS=lurg_notes

# Email registration and password recovery use Brevo. Leave blank until configured.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Lurg Notes
# BREVO_TEMPLATE_VERIFY_EMAIL_ID=12345
AUTH_OTP_HMAC_SECRET=

# Notes editor AI. Ordinary encrypted sync does not require an AI credential.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
WEB_SEARCH_ENABLED=false

# Optional private event stream for the LCP server.
LCP_EVENT_BUS_REDIS_URL=
LCP_INTERNAL_TOKEN=

# Optional Android release push notifications. Keep service account JSON outside Git.
FIREBASE_SERVICE_ACCOUNT_FILE=
PUSH_INTERNAL_TOKEN=
