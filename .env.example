# Generate separate local values, for example: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Use a hex database password so it needs no URL escaping in compose.yml.
POSTGRES_PASSWORD=
JWT_SECRET=
AUTH_OTP_HMAC_SECRET=
LCP_INTERNAL_TOKEN=

# Optional services; keys belong only in your private .env.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
GEMINI_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Set the ID of your own Brevo verification template to enable email delivery.
BREVO_TEMPLATE_VERIFY_EMAIL_ID=0
