LCP_GATEWAY_ID=gw_local
LCP_PROTOCOL_VERSION=1
LCP_MAX_FRAME_BYTES=65536
LCP_MAX_INFLIGHT_REQUESTS=32
LCP_HELLO_TIMEOUT_SECONDS=10
LCP_AUTH_TIMEOUT_SECONDS=30
LCP_REPLAY_MAX_EVENTS=10000
LCP_REPLAY_MAX_AGE_SECONDS=600
LCP_SESSION_TTL_SECONDS=86400
LCP_HEARTBEAT_SECONDS=5
REDIS_URL=redis://redis:6379/0
AUTH_JWT_SECRET=replace-with-the-shared-Lurg-JWT-secret
AUTH_JWT_ISSUER=https://auth.lurg.pro
AUTH_JWT_AUDIENCE=lurg
AUTH_SESSION_STATUS_URL=http://backend:8000/v1/auth/internal/session-status
LCP_AUTH_CHECK_CACHE_SECONDS=5
NEARBY_SERVICE_URL=http://nearby:8000/api/v1
LCP_INTERNAL_TOKEN=replace-with-a-private-network-token
LCP_SEND_TIMEOUT_SECONDS=5
LCP_DELIVERY_POLL_SECONDS=0.1
LCP_DELIVERY_BATCH_SIZE=128
LCP_MAX_CONNECTIONS=1000
LCP_MAX_SUBSCRIPTIONS=32
LCP_IDEMPOTENCY_PROCESSING_SECONDS=30
LCP_EVENT_STREAM_MAX_EVENTS=100000
LCP_LEGACY_PUBSUB_ENABLED=true
